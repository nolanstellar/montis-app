{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Montis",
  "version": "0.1.11-beta.1",
  "identifier": "fr.agency-stellar.montis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "trayIcon": {
      "id": "montis",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Montis"
    },
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nolanstellar/montis-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQ0ZEQkIxMzk2RkU5RUMKUldUczZXODVzZHZQcktXekpYYzh1NXZ2WTczN2doYzRmTExCYk10Z0dhWmhwbTYwTGNtY3JOTisK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Montis, l'assistant Stellar sur votre poste de travail.",
    "longDescription": "Montis vit dans la barre des menus. Appelez-le par la voix ou un raccourci : il répond et agit sur cet ordinateur, puis s'efface.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}